{% extends 'dashboard_base.html' %}
{% block active_page %}dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Welcome back, {{ current_user.first_name }} 👋{% endblock %}

{% block app_content %}
{% from 'partials/_status_badge.html' import status_badge %}

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="card stat-card">
      <div class="stat-icon grad-a"><i class="bi bi-cash-stack"></i></div>
      <span class="stat-label">Outstanding Balance</span>
      <strong class="stat-value">{{ outstanding|kes }}</strong>
      <small class="text-muted">Total to repay</small>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card stat-card">
      <div class="stat-icon grad-b"><i class="bi bi-wallet2"></i></div>
      <span class="stat-label">Active Loans</span>
      <strong class="stat-value">{{ active_loans }}</strong>
      <small class="text-muted">In repayment</small>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card stat-card">
      <div class="stat-icon grad-c"><i class="bi bi-graph-up-arrow"></i></div>
      <span class="stat-label">Total Borrowed</span>
      <strong class="stat-value">{{ total_borrowed|kes }}</strong>
      <small class="text-muted">All time</small>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card stat-card">
      <div class="stat-icon grad-d"><i class="bi bi-patch-check"></i></div>
      <span class="stat-label">Completed Loans</span>
      <strong class="stat-value">{{ completed_loans }}</strong>
      <small class="text-muted">Fully repaid</small>
    </div>
  </div>
</div>

<!-- Chart + notifications -->
<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card app-card h-100">
      <div class="card-header app-card-header">
        <h5 class="mb-0"><i class="bi bi-bar-chart-line me-2 text-green"></i>Monthly Spending</h5>
      </div>
      <div class="card-body">
        <canvas id="spendChart"
                data-labels='{{ chart_labels|tojson }}'
                data-values='{{ chart_values|tojson }}'
                height="110"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card app-card h-100">
      <div class="card-header app-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bell me-2 text-green"></i>Notifications</h5>
        <a href="{{ url_for('dashboard.notifications') }}" class="small text-green">View all</a>
      </div>
      <div class="card-body p-0">
        <ul class="list-group list-group-flush mini-list">
          {% for n in recent_notifications %}
          <li class="list-group-item d-flex gap-3 align-items-start">
            <span class="mini-icon icon-{{ n.category }}"><i class="bi bi-bell"></i></span>
            <div>
              <strong class="d-block">{{ n.title }}</strong>
              <small class="text-muted d-block">{{ n.message|truncate(90) }}</small>
              <small class="text-muted">{{ n.created_at.strftime('%d %b, %I:%M %p') }}</small>
            </div>
          </li>
          {% else %}
          <li class="list-group-item text-center text-muted py-4">No notifications yet.</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Quick actions -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <a class="card quick-card" href="{{ url_for('loans.apply') }}">
      <i class="bi bi-rocket-takeoff"></i><span>New Loan</span>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a class="card quick-card" href="{{ url_for('payments.deposit') }}">
      <i class="bi bi-plus-circle"></i><span>Deposit</span>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a class="card quick-card" href="{{ url_for('dashboard.messages') }}">
      <i class="bi bi-chat-dots"></i><span>Messages</span>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a class="card quick-card" href="{{ url_for('dashboard.support') }}">
      <i class="bi bi-headset"></i><span>Support</span>
    </a>
  </div>
</div>

<!-- Recent transactions -->
<div class="card app-card">
  <div class="card-header app-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2 text-green"></i>Recent Transactions</h5>
    <a href="{{ url_for('payments.deposit') }}" class="btn btn-sm btn-outline-green">+ New Deposit</a>
  </div>
  <div class="table-responsive">
    <table class="table app-table align-middle mb-0">
      <thead>
        <tr>
          <th>Description</th><th>Date</th><th class="text-end">Amount Paid</th><th class="text-center">Status</th>
        </tr>
      </thead>
      <tbody>
        {% for t in recent_transactions %}
        <tr>
          <td>
            <div class="d-flex align-items-center gap-2">
              <span class="txn-icon"><i class="bi {{ 'bi-arrow-down-circle' if t.kind == 'deposit' else 'bi-arrow-up-circle' }}"></i></span>
              <div>
                <strong class="d-block">{{ t.description }}</strong>
                <small class="text-muted">{{ t.reference }}</small>
              </div>
            </div>
          </td>
          <td class="text-muted small">{{ t.created_at.strftime('%d %b %Y') }}</td>
          <td class="text-end fw-semibold">{{ t.total_amount|kes }}</td>
          <td class="text-center">{{ status_badge(t.status) }}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="text-center text-muted py-4">No transactions yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}